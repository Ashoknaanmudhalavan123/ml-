   "source": [
    "students=[]\n",
    "ask=input(\"Are you enter the name 'Y' or 'N' \")\n",
    "while ask=='Y':\n",
    "    n=input(\"Enter the Name :\")\n",
    "students.append(n)\n",
    "\n",
    "print(\"All students name \")\n",
    "print(students)"
